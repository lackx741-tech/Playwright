# PageForgeX runtime configuration
# Copy to .env and adjust. Values are read from the process environment,
# so export them in your shell or load them before running the CLI.

# --- Output ---
PAGEFORGEX_OUTPUT_DIR=output

# --- Browser (Playwright) ---
PAGEFORGEX_BROWSER_HEADLESS=true
PAGEFORGEX_NAV_TIMEOUT_MS=30000
PAGEFORGEX_ACTION_TIMEOUT_MS=10000
PAGEFORGEX_USER_AGENT=

# --- Parsing (Cheerio) ---
PAGEFORGEX_BASE_URI=

# --- Security ---
# Set to true to allow scanning localhost / private network addresses.
PAGEFORGEX_ALLOW_PRIVATE_NETWORK=false

# --- Dashboard ---
PAGEFORGEX_DASHBOARD_PORT=12000
